<%@ page import="jbailey.stu.mmu.bigbook.commons.model.Book" %>
<%@ page import="java.util.List" %>
<%
    List<Book> recentBooksLIst = (List<Book>) request.getAttribute("recentBooks");
%>
<div class="recent-books">
    <h2>Most Recent Books</h2>

    <% if (recentBooksLIst != null && !recentBooksLIst.isEmpty()) { %>
    <% for (Book recentBook : recentBooksLIst) {
            request.setAttribute("bookItem", recentBook);
            request.setAttribute("showBookActions", Boolean.TRUE); %>
    <!-- Add one book item for each recent book for modularity -->
    <%@ include file="/WEB-INF/views/fragments/cards/bookItem.jspf" %>
    <% } %>
    <% request.removeAttribute("bookItem");
       request.removeAttribute("showBookActions"); %>
    <% } else { %>
    <div class="no-books">
        <h2>No recent books found.</h2>
        <p>There are currently no recent books in the database.</p>
    </div>
    <% } %>
</div>


