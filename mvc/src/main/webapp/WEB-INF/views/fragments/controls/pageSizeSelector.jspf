<!-- Selection Fragment for choosing list count fo -->
<% String pageSizeFormAction = (String) request.getAttribute("pageSizeFormAction");
    if (pageSizeFormAction == null || pageSizeFormAction.isEmpty()) {
        pageSizeFormAction = request.getContextPath() + "/bigbookmvc/books";
    }

    String pageSizeHiddenFieldName = (String) request.getAttribute("pageSizeHiddenFieldName");
    String pageSizeHiddenFieldValue = (String) request.getAttribute("pageSizeHiddenFieldValue");

    // Default 10 if none are set
    Integer pageSizeAttribute = (Integer) request.getAttribute("pageSize");
    int selectedPageSize = pageSizeAttribute != null ? pageSizeAttribute : 10; %>

<div class="page-size-selector">
    <form action="<%= pageSizeFormAction %>" method="get" style="display: inline;">
        <% if (pageSizeHiddenFieldName != null && !pageSizeHiddenFieldName.isEmpty()) { %>
        <input type="hidden" name="<%= pageSizeHiddenFieldName %>" value="<%= pageSizeHiddenFieldValue != null ? pageSizeHiddenFieldValue : "" %>">
        <% } %>

        <label for="pageSize">Books per page:</label>
        <select name="pageSize" id="pageSize">
            <!-- add any options we want on here really -->
            <option value="5" <%= selectedPageSize == 5 ? "selected" : "" %>>5</option>
            <option value="10" <%= selectedPageSize == 10 ? "selected" : "" %>>10</option>
            <option value="20" <%= selectedPageSize == 20 ? "selected" : "" %>>20</option>
            <option value="50" <%= selectedPageSize == 50 ? "selected" : "" %>>50</option>
            <option value="100" <%= selectedPageSize == 100 ? "selected" : "" %>>100</option>
        </select>
        <button type="submit">Apply</button>
    </form>
</div>


