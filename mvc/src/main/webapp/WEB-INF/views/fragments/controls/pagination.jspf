<%
	Integer currentPageAttribute = (Integer) request.getAttribute("currentPage");
	Integer totalPagesAttribute = (Integer) request.getAttribute("totalPages");
	Integer pageSiseAttribute = (Integer) request.getAttribute("pageSize");

	int currentPageFinal = currentPageAttribute != null ? currentPageAttribute : 0;
	int totalPageFinal = totalPagesAttribute != null ? totalPagesAttribute : 0;
	int pageSizeFinal = pageSiseAttribute != null ? pageSiseAttribute : 10;

	String basePath = (String) request.getAttribute("paginationBasePath");
	if (basePath == null || basePath.isEmpty()) {
		basePath = "/bigbookmvc/books";
	}

	String paginationQueryPrefix = (String) request.getAttribute("paginationQueryPrefix");
	String paginationQueryJoin = (paginationQueryPrefix != null && !paginationQueryPrefix.isEmpty())
			? paginationQueryPrefix + "&"
			: "";
%>

<div class="pagination">
	<%
		if (totalPageFinal > 1) {
			if (currentPageFinal > 0) {
	%>
	<a href="<%= request.getContextPath() %><%= basePath %>?<%= paginationQueryJoin %>page=<%= currentPageFinal - 1 %>&pageSize=<%= pageSizeFinal %>">&laquo; Prev</a>
	<%
			}

			int maxPageLinks = 10; // hard coded but could be changed
			int start = Math.max(0, currentPageFinal - (maxPageLinks / 2));
			int end = Math.min(totalPageFinal - 1, start + maxPageLinks - 1);
			if ((end - start + 1) < maxPageLinks) {
				start = Math.max(0, end - maxPageLinks + 1);
			}

			for (int i = start; i <= end; i++) {
				if (i == currentPageFinal) { %>
	<span class="current"><%= i + 1 %></span>
    <%
				} else {
	%>
	<a href="<%= request.getContextPath() %><%= basePath %>?<%= paginationQueryJoin %>page=<%= i %>&pageSize=<%= pageSizeFinal %>"><%= i + 1 %></a>
	<%
				}
			}

			if (currentPageFinal < totalPageFinal - 1) {
	%>
	<a href="<%= request.getContextPath() %><%= basePath %>?<%= paginationQueryJoin %>page=<%= currentPageFinal + 1 %>&pageSize=<%= pageSizeFinal %>">Next &raquo;</a>
	<%
			}
		}
	%>
</div>


