.search-form {
    margin: 20px 0;
    padding: 15px;
    background-color: var(--light-bg);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    width: 100%;
    max-width: 420px;
}

.visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
}

.search-form input {
    padding: 8px;
    margin-right: 10px;
    width: calc(100% - 120px);
}

.search-form button {
    padding: 8px 15px;
    background-color: var(--primary-color);
    color: white;
    border: none;
    cursor: pointer;
    border-radius: 4px;
}

.search-form button:hover {
    background-color: var(--secondary-color);
}


