.menu {
    margin: 20px 0;
}

.menu a {
    display: inline-block;
    margin-right: 15px;
    padding: 10px 20px;
    background-color: var(--primary-color);
    color: white;
    text-decoration: none;
    border-radius: 4px;
}

.menu a:last-child {
    margin-right: 0;
}

.menu a:hover {
    background-color: var(--secondary-color);
}

