<%@ page import="jbailey.stu.mmu.bigbook.commons.model.Book" %>
<%@ page import="jbailey.stu.mmu.bigbook.commons.model.Genre" %>
<%@ page import="jbailey.stu.mmu.bigbook.commons.model.Character" %>
<%@ page import="jbailey.stu.mmu.bigbook.commons.util.DateUtility" %>
<%@ page import="java.util.List" %>
<%
    // Shared Book card fragment. Parent JSP sets request attribute: "bookItem".
    Book bookItemData = (Book) request.getAttribute("bookItem");
    boolean bookItemShowActions = true;
    Object bookItemShowActionsAttr = request.getAttribute("showBookActions");
    if (bookItemShowActionsAttr instanceof Boolean) {
        bookItemShowActions = (Boolean) bookItemShowActionsAttr;
    }

    if (bookItemData != null) {
        String bookItemIsoForValidCheck = DateUtility.displayISODate(bookItemData.getDate());
        boolean bookItemValidDate = false;
        if (bookItemIsoForValidCheck != null && !bookItemIsoForValidCheck.isEmpty()) {
            try {
                java.time.LocalDate parsedDate = java.time.LocalDate.parse(bookItemIsoForValidCheck);
                bookItemValidDate = !parsedDate.isAfter(java.time.LocalDate.now());
            } catch (Exception silentException) {
                bookItemValidDate = false;
            }
        }

        String bookItemDateOutput;
        if (bookItemIsoForValidCheck == null || bookItemIsoForValidCheck.isEmpty()) {
            bookItemDateOutput = DateUtility.INVALID_DATE_MESSAGE;
        } else {
            try {
                java.time.LocalDate parsedDate = java.time.LocalDate.parse(bookItemIsoForValidCheck);
                bookItemDateOutput = parsedDate.isAfter(java.time.LocalDate.now())
                        ? DateUtility.INVALID_DATE_MESSAGE
                        : bookItemIsoForValidCheck;
            } catch (Exception ex) {
                bookItemDateOutput = DateUtility.INVALID_DATE_MESSAGE;
            }
        }
%>
<div class="book-item<%= bookItemValidDate ? "" : " invalid-date" %>">
    <div class="book-header" onclick="toggleBook(this)">
        <div class="book-title-author">
            <div class="book-title"><%= bookItemData.getTitle() %></div>
            <div class="book-author">by <%= bookItemData.getAuthor() %></div>
        </div>
        <div class="expand-icon">&#9660;</div>
    </div>

    <div class="book-details">
        <div class="detail-row">
            <div class="detail-label">ID:</div>
            <div class="detail-value"><%= bookItemData.getId() %></div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Date:</div>
            <div class="detail-value"><%= bookItemDateOutput %></div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Genres:</div>
            <div class="detail-value">
                <%
                    List<Genre> genres = bookItemData.getGenres();
                    if (genres != null && !genres.isEmpty()) {
                        for (Genre g : genres) {
                %>
                <span class="pill"><%= g.getName() %></span>
                <%
                        }
                    } else {
                %>
                No genres listed
                <%
                    }
                %>
            </div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Characters:</div>
            <div class="detail-value">
                <%
                    List<Character> characters = bookItemData.getCharacters();
                    if (characters != null && !characters.isEmpty()) {
                        for (Character c : characters) {
                %>
                <span class="pill"><%= c.getName() %></span>
                <%
                        }
                    } else {
                %>
                No characters listed
                <%
                    }
                %>
            </div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Synopsis:</div>
            <div class="detail-value">
                <%= bookItemData.getSynopsis() != null && !bookItemData.getSynopsis().isEmpty() ? bookItemData.getSynopsis() : "No synopsis available" %>
            </div>
        </div>

        <% if (bookItemShowActions) { %>
        <div class="book-actions">
            <a href="<%= request.getContextPath() %>/bigbookmvc/books/edit?id=<%= bookItemData.getId() %>" class="edit">Edit</a>
            <a href="<%= request.getContextPath() %>/bigbookmvc/books/delete?id=<%= bookItemData.getId() %>" class="delete" onclick="return confirm('Are you sure you want to delete this book?')">Delete</a>
        </div>
        <% } %>
    </div>
</div>
<%
    }
%>


