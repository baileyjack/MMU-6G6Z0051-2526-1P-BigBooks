.page-size-selector {
    margin-bottom: 20px;
    text-align: center;
}

.page-size-selector select {
    padding: 8px;
    background-color: var(--light-bg);
    color: var(--text-color);
    border: 1px solid var(--border-color);
    border-radius: 4px;
}

.page-size-selector button {
    padding: 8px 15px;
    background-color: var(--primary-color);
    color: white;
    border: none;
    cursor: pointer;
    border-radius: 4px;
    margin-left: 10px;
}

.page-size-selector button:hover {
    background-color: var(--secondary-color);
}

.no-books {
    text-align: center;
    padding: 40px;
    color: #999;
    background-color: var(--bg-color);
    border-radius: 4px;
    border: 1px solid var(--border-color);
}

.pagination {
    text-align: center;
    margin-top: 20px;
}

.pagination a,
.pagination span {
    display: inline-block;
    padding: 8px 12px;
    margin: 0 2px;
    text-decoration: none;
    border-radius: 4px;
    background-color: var(--light-bg);
    color: var(--text-color);
    border: 1px solid var(--border-color);
}

.pagination a:hover {
    background-color: var(--primary-color);
    color: white;
}

.pagination .current {
    background-color: var(--primary-color);
    color: white;
}

.back-link {
    display: inline-block;
    margin-top: 20px;
    padding: 10px 20px;
    background-color: var(--primary-color);
    color: white;
    text-decoration: none;
    border-radius: 4px;
}

.back-link:hover {
    background-color: var(--secondary-color);
}


