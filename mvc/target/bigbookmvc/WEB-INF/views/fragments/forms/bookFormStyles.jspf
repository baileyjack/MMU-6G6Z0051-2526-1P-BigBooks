.form-shell {
	max-width: 650px;
	width: 100%;
	margin-top: 20px;
	background-color: var(--light-bg);
	border: 1px solid var(--border-color);
	border-radius: 8px;
	padding: 20px;
}

label {
	display: block;
	margin-top: 10px;
	font-weight: bold;
}

input[type="text"],
textarea {
	width: 100%;
	padding: 8px;
	margin-top: 5px;
	box-sizing: border-box;
	background-color: var(--bg-color);
	color: var(--text-color);
	border: 1px solid var(--border-color);
	border-radius: 4px;
}

textarea {
	resize: vertical;
}

button[type="submit"] {
	margin-top: 15px;
	padding: 10px 20px;
	background-color: var(--primary-color);
	color: white;
	border: none;
	border-radius: 4px;
	cursor: pointer;
}

button[type="submit"]:hover {
	background-color: var(--secondary-color);
}

