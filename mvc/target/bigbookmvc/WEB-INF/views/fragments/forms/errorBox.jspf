<%@ page import="java.util.List" %>
<%
	List<String> errors = (List<String>) request.getAttribute("errors");
	if (errors != null && !errors.isEmpty()) {
%>
<div class="error-box">
	<strong>Please fix the following errors:</strong>
	<ul>
		<% for (String error : errors) { %>
		<li><%= error %></li>
		<% } %>
	</ul>
</div>
<%
	}
%>

