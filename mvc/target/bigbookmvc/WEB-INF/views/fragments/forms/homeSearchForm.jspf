<div class="search-form">
    <form action="<%= request.getContextPath() %>/bigbookmvc/search" method="get">
        <label for="home-search" class="visually-hidden">Search by title or author</label>
        <input type="text" id="home-search" name="search" placeholder="Search by title or author..." required>
        <button type="submit">Search</button>
    </form>
</div>


