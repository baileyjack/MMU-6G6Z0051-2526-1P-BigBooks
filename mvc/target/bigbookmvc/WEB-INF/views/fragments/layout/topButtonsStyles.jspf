.top-buttons {
	position: absolute;
	top: 20px;
	right: 20px;
	display: flex;
	gap: 10px;
}

.top-buttons a {
	padding: 10px 20px;
	background-color: var(--primary-color);
	color: white;
	text-decoration: none;
	border-radius: 4px;
}

.top-buttons a:hover {
	background-color: var(--secondary-color);
}

